# Copy to demo-bank/.env.local (never commit the real file).
# Server-side only: none of these use the NEXT_PUBLIC_ prefix, so they never reach the browser.

MOHAR_API_URL=http://localhost:4000
MOHAR_API_KEY=mk_test_local
# This bank's own webhook secret: its entry in the API's PARTNER_WEBHOOK_SECRETS.
MOHAR_WEBHOOK_SECRET=whsec_local_dev_only
# MOHAR's operator key (the API's DEV_API_KEY), only for the demo panel's price buttons.
MOHAR_DEV_KEY=mk_dev_local
