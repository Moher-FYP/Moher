# Copy to contracts/.env (never commit the real file).

# RPC for Polygon Amoy testnet (chain id 80002), e.g. from Alchemy or Infura.
AMOY_RPC_URL=

# Deployer / admin key for testnet ONLY. Use a fresh wallet funded from the Amoy faucet.
DEPLOYER_PRIVATE_KEY=

# Addresses that receive roles at deploy time (see docs/contracts.md).
RELAYER_ADDRESS=
VAULT_SIGNER_ADDRESS=

# Leave empty to deploy MockV3Aggregator instead of using a Chainlink feed.
XAU_USD_FEED_ADDRESS=
