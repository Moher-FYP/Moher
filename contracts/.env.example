# Copy to contracts/.env (never commit the real file).

# RPC for Polygon Amoy testnet (chain id 80002), e.g. from Alchemy or Infura.
AMOY_RPC_URL=

# Deployer / admin key for testnet ONLY. Use a fresh wallet funded from the Amoy faucet.
DEPLOYER_PRIVATE_KEY=

# Addresses that receive roles at deploy time (see docs/contracts.md).
RELAYER_ADDRESS=
VAULT_SIGNER_ADDRESS=

# Leave empty to deploy MockV3Aggregator instead of using a Chainlink feed.
XAU_USD_FEED_ADDRESS=
# Starting price for the mock feed (USD per troy ounce, 8 decimals). Default 4616e8.
INITIAL_XAU_USD=
# Maximum oracle age in seconds before mint/burn revert. Default 3600.
MAX_STALENESS_SECONDS=
# Partner id registered at deploy (stored as keccak256 of this string). Default "demo-bank".
DEMO_PARTNER_ID=

# On Anvil (chain 31337) none of the above is needed: Deploy.s.sol uses Anvil accounts
# #0 (admin), #1 (relayer) and #2 (vault signer).
