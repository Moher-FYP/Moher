{
  "name": "@mohar/api",
  "version": "0.1.0",
  "description": "MOHAR partner API, mock vault and relayer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "abi": "node scripts/extract-abis.mjs",
    "portal:user": "tsx --disable-warning=ExperimentalWarning src/portal/cli.ts",
    "simulate": "tsx --disable-warning=ExperimentalWarning src/sim/cli.ts"
  },
  "dependencies": {
    "@mohar/sdk": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "dotenv": "^18.0.5",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "viem": "^2.57.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "playwright": "1.63.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  }
}
