{
  "name": "@mohar/api",
  "version": "0.1.0",
  "description": "MOHAR partner API, mock vault and relayer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
