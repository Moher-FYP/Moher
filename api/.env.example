# Copy to api/.env for local development (never commit the real file).

PORT=4000

# Local Anvil by default. For Amoy use your Alchemy/Infura URL.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Postgres (local Docker or Neon). Used from the next PR onwards.
DATABASE_URL=postgresql://mohar:mohar@localhost:5432/mohar

# Relayer: holds SETTLEMENT/OPERATOR/REGISTRAR/PUBLISHER roles. Testnet key only.
# Anvil's default account #0 key is fine for local development.
RELAYER_PRIVATE_KEY=

# Mock vault signer: signs Allocation / Deallocation / ReserveAttestation (EIP-712).
# Anvil's default account #1 key is fine for local development.
VAULT_SIGNER_PRIVATE_KEY=

# Filled in after deploying contracts (see contracts/script).
MOHAR_TOKEN_ADDRESS=
WALLET_REGISTRY_ADDRESS=
RESERVE_REGISTRY_ADDRESS=
XAU_USD_FEED_ADDRESS=

# Off-chain PKR per USD used for quotes (no Chainlink PKR feed on Polygon).
USD_PKR_RATE=279.05

# HMAC secret used to sign webhooks sent to the demo bank.
WEBHOOK_SECRET=whsec_local_dev_only
