# Copy to api/.env (never commit the real file). On local Anvil every value below is optional:
# the defaults match `pnpm chain` + `pnpm contracts:deploy:local`.

PORT=4000
# 127.0.0.1 accepts connections from this machine only. On a server, set 0.0.0.0 and put the
# API behind a proxy that provides HTTPS.
HOST=127.0.0.1
RPC_URL=http://127.0.0.1:8545

# Written by contracts/script/Deploy.s.sol. For Amoy: ../contracts/deployments/80002.json
DEPLOYMENT_FILE=../contracts/deployments/31337.json

# Required outside Anvil. On Anvil they default to the accounts Deploy.s.sol trusts
# (#1 relayer, #2 vault) and the standard test mnemonic. Testnet keys only — never real funds.
RELAYER_PRIVATE_KEY=
VAULT_SIGNER_PRIVATE_KEY=
# Custodial customer wallets are derived from this mnemonic (m/44'/60'/1'/0/i).
WALLET_MNEMONIC=

# Testnet with the mock feed only: follow Chainlink's real XAU/USD feed on Polygon mainnet, so
# Amoy shows the market price. Set both or neither. Reading mainnet is free. Take the feed
# address from https://data.chain.link/feeds/polygon/mainnet/xau-usd (the API checks it is an
# 8-decimal XAU/USD feed before using it).
MIRROR_RPC_URL=
MIRROR_FEED_ADDRESS=
# Copy the reference once it differs by this much (20 = 0.20%). Lower = closer, more test POL.
MIRROR_MIN_MOVE_BPS=20
MIRROR_INTERVAL_SECONDS=120
# After "Gold up 1%" (/dev/price), keep the demo price this long before mirroring again.
MIRROR_HOLD_SECONDS=600

# Keys the KYC fingerprint stored on-chain with each wallet, so it cannot be reversed by
# guessing (a plain hash of a CNIC could be). Required off local Anvil. Keep it safe for as
# long as wallets exist.
KYC_HASH_SECRET=

# Pricing (FYP-1 §2.2.6). There is no PKR feed on Polygon, so PKR/USD is configured here.
USD_PKR_RATE=279.05
# What a customer may receive (buy, or be sent) per KYC level, in PKR:
# level=perTrade:per24Hours:per30Days:maxHolding. Modelled on the State Bank's account levels
# (asaan ~ branchless Level 0, standard ~ Asaan Account); each partner confirms its own.
KYC_LIMITS=asaan=25000:25000:50000:200000,standard=200000:500000:1000000:1000000,enhanced=2500000:5000000:20000000:50000000
PLATFORM_FEE_BPS=50
FX_MARGIN_BPS=25
QUOTE_TTL_SECONDS=60

# Partners: comma-separated apiKey=slug pairs, and slug=url webhook targets.
# The values below are public (they are in this repo), so they work on local Anvil only. On any
# other chain the API refuses to start until every key and secret is your own, at least 24
# characters, and not shared between partners. Generate each with: openssl rand -hex 24
PARTNER_API_KEYS=mk_test_local=demo-bank,mk_test_wallet=moher-wallet
PARTNER_WEBHOOK_URLS=demo-bank=http://localhost:3000/api/mohar/webhooks,moher-wallet=http://localhost:3001/api/mohar/webhooks
# One webhook signing secret per partner, as slug=secret pairs. Required off local Anvil.
PARTNER_WEBHOOK_SECRETS=
# Local Anvil only: signs for partners with no entry above.
WEBHOOK_SECRET=whsec_local_dev_only

# Allowances per partner. A new wallet is an on-chain transaction the relayer pays for.
RATE_LIMIT_PER_MINUTE=600
WALLET_REGISTRATIONS_PER_HOUR=120

# JSON store location (":memory:" for no persistence).
DATA_DIR=.data

# /dev routes (move the mock gold price). Default: on for Anvil, off elsewhere.
ENABLE_DEV_ROUTES=
# The operator key for /dev routes. Partner keys are refused there. Required off local Anvil
# when ENABLE_DEV_ROUTES=true; on Anvil it defaults to mk_dev_local.
DEV_API_KEY=
# A manual price must stay this close to the reference price (500 = 5%).
DEV_PRICE_BAND_BPS=500
