# Copy to api/.env (never commit the real file). On local Anvil every value below is optional:
# the defaults match `pnpm chain` + `pnpm contracts:deploy:local`.

PORT=4000
RPC_URL=http://127.0.0.1:8545

# Written by contracts/script/Deploy.s.sol. For Amoy: ../contracts/deployments/80002.json
DEPLOYMENT_FILE=../contracts/deployments/31337.json

# Required outside Anvil. On Anvil they default to the accounts Deploy.s.sol trusts
# (#1 relayer, #2 vault) and the standard test mnemonic. Testnet keys only — never real funds.
RELAYER_PRIVATE_KEY=
VAULT_SIGNER_PRIVATE_KEY=
# Custodial customer wallets are derived from this mnemonic (m/44'/60'/1'/0/i).
WALLET_MNEMONIC=

# Testnet with the mock feed only: follow Chainlink's real XAU/USD feed on Polygon mainnet, so
# Amoy shows the market price. Set both or neither. Reading mainnet is free. Take the feed
# address from https://data.chain.link/feeds/polygon/mainnet/xau-usd (the API checks it is an
# 8-decimal XAU/USD feed before using it).
MIRROR_RPC_URL=
MIRROR_FEED_ADDRESS=
# Copy the reference once it differs by this much (20 = 0.20%). Lower = closer, more test POL.
MIRROR_MIN_MOVE_BPS=20
MIRROR_INTERVAL_SECONDS=120
# After "Gold up 1%" (/dev/price), keep the demo price this long before mirroring again.
MIRROR_HOLD_SECONDS=600

# Pricing (FYP-1 §2.2.6). There is no PKR feed on Polygon, so PKR/USD is configured here.
USD_PKR_RATE=279.05
PLATFORM_FEE_BPS=50
FX_MARGIN_BPS=25
QUOTE_TTL_SECONDS=60

# Partners: comma-separated apiKey=slug pairs, and slug=url webhook targets.
PARTNER_API_KEYS=mk_test_local=demo-bank
PARTNER_WEBHOOK_URLS=demo-bank=http://localhost:3000/api/mohar/webhooks
WEBHOOK_SECRET=whsec_local_dev_only

# JSON store location (":memory:" for no persistence).
DATA_DIR=.data

# /dev routes (move the mock gold price). Default: on for Anvil, off elsewhere.
ENABLE_DEV_ROUTES=
