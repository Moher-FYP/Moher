{
  "name": "moher",
  "private": true,
  "description": "MOHAR \u2014 Shariah-compliant gold tokenization infrastructure (FAST-NUCES FYP)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "chain": "anvil",
    "spec:lint": "redocly lint docs/openapi.yaml",
    "contracts:deploy:local": "cd contracts && forge script script/Deploy.s.sol --rpc-url local --broadcast",
    "test:e2e": "pnpm --filter @mohar/api test:e2e"
  },
  "devDependencies": {
    "@redocly/cli": "^2.57.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
